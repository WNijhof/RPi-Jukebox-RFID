[Unit]
# Eigen uitbreiding muziekbox: install the latest GitHub release while nothing is playing
Description=Update Muziekbox to the latest release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%%PROJECT_ROOT%%/installation/components/update_jukebox.sh
# The journal on the box is volatile: keep the result after a shutdown
StandardOutput=append:%%PROJECT_ROOT%%/shared/logs/update.log
StandardError=append:%%PROJECT_ROOT%%/shared/logs/update.log
