[Unit]
# Eigen uitbreiding muziekbox: Spotify Connect speaker, plays via the PulseAudio of the Jukebox
Description=Spotify Connect (librespot)
After=network-online.target sound.target pulseaudio.service
Wants=network-online.target pulseaudio.service

[Service]
# --volume-ctrl fixed: the Spotify app cannot change the volume, the Jukebox volume (and max volume) rules
# --cache: remembers the login after selecting the speaker once in the Spotify app
ExecStart=/usr/bin/librespot \
  --name "%%DEVICE_NAME%%" \
  --device-type speaker \
  --backend pulseaudio \
  --bitrate %%BITRATE%% \
  --cache %h/.cache/librespot \
  --disable-audio-cache \
  --volume-ctrl fixed \
  --initial-volume 100 \
  --enable-volume-normalisation
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
